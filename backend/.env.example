PORT=3000
NODE_ENV=development

# Travelpayouts Affiliate Configuration
# Get these from your Travelpayouts partner dashboard
TRAVELPAYOUTS_MARKER=your_marker_id
TRAVELPAYOUTS_TRS=your_trs_id
TRAVELPAYOUTS_P_KLOOK=4110
TRAVELPAYOUTS_CAMPAIGN_KLOOK=137

# Klook Commission Settings
# Approximate commission rate from Travelpayouts for Klook
TRAVELPAYOUTS_KLOOK_COMMISSION_RATE=0.05
# Percentage of commission shared with the user as cashback
USER_CASHBACK_SHARE_PERCENT=0.50

# Exchange Rate API (free tier)
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/USD

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
